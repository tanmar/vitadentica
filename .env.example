# Wzór pliku .env dla `npm run deploy` (scripts/deploy-ftp.mjs).
# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore: nigdy go nie commituj.

# Adres serwera FTP z panelu LH.pl (sama nazwa, bez ftp:// i ścieżki).
FTP_HOST=ftp.example.com

# Login i hasło konta FTP.
FTP_USER=twoj-login-ftp
FTP_PASSWORD=twoje-haslo-ftp

# Katalog na serwerze, w którym leży strona (ścieżka bezwzględna). Wymagane, bez wartości domyślnej,
# żeby nie wysłać plików w złe miejsce. Skrypt nigdy nie usuwa niczego spoza własnego manifestu.
FTP_REMOTE_DIR=/public_html/vitadentica.pl

# Port FTP (domyślnie 21; dla FTP_SECURE=implicit domyślnie 990).
# FTP_PORT=21

# Szyfrowanie: true = FTPS jawny (AUTH TLS, domyślnie), implicit = FTPS niejawny, false = zwykły FTP.
# UWAGA: false wysyła login i hasło otwartym tekstem. Używaj tylko, gdy serwer nie obsługuje FTPS.
# FTP_SECURE=true

# Hosting współdzielony często ma certyfikat wystawiony na inną nazwę lub samopodpisany. Wtedy połączenie
# kończy się błędem certyfikatu; ustaw true, żeby go zaakceptować (słabsza ochrona przed podszyciem się pod serwer).
# Domyślnie certyfikat jest sprawdzany ściśle.
# FTP_ALLOW_SELF_SIGNED=false

# Adres strony do testu po wdrożeniu (`npm run deploy -- --check`). Domyślnie https://vitadentica.pl.
# SITE_URL=https://vitadentica.pl
