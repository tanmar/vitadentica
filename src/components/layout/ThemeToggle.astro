---
// Widoczny dopiero po uruchomieniu src/scripts/theme.ts (bez JS przełącznik nic by nie robił).
// `header`: okrągła ikona w nagłówku (tablet i desktop). `row`: wiersz w menu mobilnym (telefon) z nazwą motywu.
interface Props {
  variant?: 'header' | 'row';
}

const { variant = 'header' } = Astro.props;
---

<button type="button" class:list={['theme-toggle', `theme-toggle--${variant}`]} data-theme-toggle data-mode="system" hidden aria-label="Zmień motyw">
  <svg class="theme-toggle__i theme-toggle__i--system" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" />
  </svg>
  <svg class="theme-toggle__i theme-toggle__i--light" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M18.7 5.3 17 7M7 17l-1.7 1.7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <svg class="theme-toggle__i theme-toggle__i--dark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
  </svg>
  {
    variant === 'row' && (
      <>
        <span class="theme-toggle__label" data-theme-label>Motyw zgodny z systemem</span>
        <span class="theme-toggle__hint" aria-hidden="true">Zmień</span>
      </>
    )
  }
</button>
