---
/**
 * Mapa dojazdu: statyczny SVG narysowany z danych OpenStreetMap (src/data/route-map.ts, generator:
 * scripts/generate-route-map.ts). Bez iframe, skryptów i zewnętrznych obrazów, więc CSP zostaje bez zmian.
 * Kolory biorą się z tokenów strony, więc mapa przełącza się razem z motywem.
 */
import '../../styles/routemap.css'; // tylko strona kontaktu: nie obciąża CSS pozostałych podstron
import { clinic, directionsUrls } from '../../lib/clinic';
import { formatApproxDistance } from '../../lib/route-map';
import { routeMap } from '../../data/route-map';

const { viewBox, layers, labels, stops, labelFontSize, smallLabelFontSize } = routeMap;
const { google, apple } = directionsUrls(clinic.geo);
const viewBoxAttr = `${viewBox.x} ${viewBox.y} ${viewBox.width} ${viewBox.height}`;

const stopSummary = stops.map((s) => `${s.name}, ${formatApproxDistance(s.distance)}`).join('; ');
const description = `Gabinet przy ${clinic.address.street}. Najbliższe przystanki autobusowe w linii prostej: ${stopSummary}.`;

// Skala 100 m w lewym dolnym rogu: jednostka viewBox to metr, więc odcinek 100 jednostek jest prawdziwą skalą.
const scaleX = viewBox.x + 28;
const scaleY = viewBox.y + viewBox.height - 30;
---

<section id="dojazd" aria-labelledby="route-heading" class="section section--aurora">
  <div class="wrap">
    <div class="reveal">
      <p class="kicker">Dojazd</p>
      <h2 id="route-heading">Jak do nas trafić</h2>
      <span class="rule"></span>
      <p class="lead" style="margin: 0;">
        {clinic.address.street}, {clinic.address.postalCode} {clinic.address.city}
      </p>
    </div>

    <div class="rmap-g reveal">
      <figure class="rmap glass glass--strong">
        <svg
          class="rmap__svg"
          viewBox={viewBoxAttr}
          role="img"
          aria-labelledby="rmap-title"
          aria-describedby="rmap-desc"
          style={`--rm-fs: ${labelFontSize}; --rm-fs-sm: ${smallLabelFontSize};`}
        >
          <title id="rmap-title">Mapa dojazdu do gabinetu {clinic.name}</title>
          <desc id="rmap-desc">{description}</desc>

          <defs>
            <path id="rm-local" d={layers.roadsLocal}></path>
            <path id="rm-collector" d={layers.roadsCollector}></path>
            <path id="rm-arterial" d={layers.roadsArterial}></path>
          </defs>

          <rect
            class="rm-land"
            x={viewBox.x}
            y={viewBox.y}
            width={viewBox.width}
            height={viewBox.height}></rect>
          <path class="rm-park" d={layers.parks}></path>
          <path class="rm-water" d={layers.waterAreas}></path>
          <path class="rm-canal" d={layers.waterLines}></path>
          <path class="rm-block" d={layers.buildings}></path>

          <use href="#rm-local" class="rm-road rm-casing--local"></use>
          <use href="#rm-collector" class="rm-road rm-casing--collector"></use>
          <use href="#rm-arterial" class="rm-road rm-casing--arterial"></use>
          <use href="#rm-local" class="rm-road rm-fill--local"></use>
          <use href="#rm-collector" class="rm-road rm-fill--collector"></use>
          <use href="#rm-arterial" class="rm-road rm-fill--arterial"></use>

          {
            labels.flatMap((l) => [
              l.desktop && (
                <text
                  class:list={['rm-label', `rm-label--${l.rank}`, 'rm-label--desk']}
                  x={l.desktop.x}
                  y={l.desktop.y}
                  transform={`rotate(${l.desktop.angle} ${l.desktop.x} ${l.desktop.y})`}
                >
                  {l.text}
                </text>
              ),
              l.small && (
                <text
                  class:list={['rm-label', `rm-label--${l.rank}`, 'rm-label--sm']}
                  x={l.small.x}
                  y={l.small.y}
                  transform={`rotate(${l.small.angle} ${l.small.x} ${l.small.y})`}
                >
                  {l.text}
                </text>
              ),
            ])
          }

          {
            stops.map((s) => (
              <g transform={`translate(${s.x} ${s.y})`}>
                <g class="rm-stop">
                  <circle r="14"></circle>
                  <text>{s.number}</text>
                </g>
              </g>
            ))
          }

          <g class="rm-pin" aria-hidden="true">
            <circle class="rm-pulse" cx="0" cy="-34" r="20"></circle>
            <g class="rm-plate">
              <rect x="26" y="-66" width="190" height="54" rx="16"></rect>
              <text class="rm-plate__name" x="42" y="-42">{clinic.name}</text>
              <text class="rm-plate__addr" x="42" y="-22">{clinic.address.streetShort}</text>
            </g>
            <path
              class="rm-pin__body"
              d="M0 0C-5-11-19-21-19-35A19 19 0 1 1 19-35C19-21 5-11 0 0Z"></path>
            <circle class="rm-pin__dot" cx="0" cy="-35" r="7"></circle>
          </g>

          <g class="rm-scale" aria-hidden="true">
            <path d={`M${scaleX} ${scaleY}h100M${scaleX} ${scaleY - 6}v12M${scaleX + 100} ${scaleY - 6}v12`}></path>
            <text x={scaleX + 50} y={scaleY - 12}>100 m</text>
          </g>
        </svg>
        <figcaption class="rmap__credit">
          Mapa: dane © współtwórcy <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a>
        </figcaption>
      </figure>

      <div class="rmap__info glass">
        <h3>Najbliższe przystanki autobusowe</h3>
        <ol class="rmap__stops" role="list">
          {
            stops.map((s) => (
              <li>
                <span class="rmap__num" aria-hidden="true">{s.number}</span>
                <span class="rmap__stop-name">{s.name}</span>
                <span class="rmap__stop-dist">{formatApproxDistance(s.distance)}</span>
              </li>
            ))
          }
        </ol>
        <p class="rmap__note">
          Odległości w linii prostej. Aktualne linie i rozkład jazdy znajdziesz po wyznaczeniu trasy w aplikacji map.
        </p>
        <div class="rmap__btns">
          <a class="btn btn--red" href={google} rel="noopener">Trasa w Mapach Google</a>
          <a class="btn btn--ghost-red" href={apple} rel="noopener">Trasa w Mapach Apple</a>
        </div>
      </div>
    </div>
  </div>
</section>
