---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import { clinic } from '../lib/clinic';
---

<BaseLayout title="Nie znaleziono strony | Vitadentica" description="Taka strona nie istnieje." path="/404" errorPage>
  <PageHero title="Nie ma takiej strony." kicker="Błąd 404" />
  <section class="section">
    <div class="wrap">
      <p class="lead" style="margin: 0 0 28px;">
        Wróć na stronę główną albo zadzwoń do gabinetu: {clinic.phone.display}.
      </p>
      <div class="hero__btns" style="margin: 0;">
        <a href="/" class="btn btn--red">Strona główna</a>
        <a href={clinic.phone.href} class="btn btn--ghost-red">Zadzwoń</a>
      </div>
    </div>
  </section>
</BaseLayout>
